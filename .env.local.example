# FinaLily — Environment Configuration
# Copy this file to .env.local:
#   cp .env.local.example .env.local

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite file path (relative to project root). The dev.db included in the repo
# is pre-seeded with a demo account — no setup needed.
DATABASE_URL="file:./dev.db"

# ─── AI Features (choose one, or leave both blank to use LM Studio fallback) ──

# Option A: OpenRouter (recommended for cloud AI — free models available)
#   Sign up at https://openrouter.ai and create an API key.
OPENROUTER_API_KEY=

# Option B: LM Studio (local AI — runs on your machine, no internet required)
#   1. Download LM Studio: https://lmstudio.ai
#   2. Download a model (e.g. qwen3.5-27b-claude-4.6-opus-reasoning-distilled-v2)
#   3. Start the local server in LM Studio (Developer tab → Start Server)
#   4. Set the URL to your machine's local IP + port 1234
LM_STUDIO_BASE_URL=http://192.168.1.28:1234/v1
LM_STUDIO_MODEL=qwen3.5-27b-claude-4.6-opus-reasoning-distilled-v2

# ─── Session ──────────────────────────────────────────────────────────────────
# Optional — used to sign session cookies for extra security.
# Generate: openssl rand -hex 32
SESSION_SECRET=
