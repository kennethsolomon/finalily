# ============================================================
# FinaLily — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ============================================================

# ------------------------------------------------------------
# Supabase — Required
# Get these from: https://supabase.com/dashboard → Project Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------
# Database — Required
# Get from: Supabase dashboard → Project Settings → Database → Connection string
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# ------------------------------------------------------------
# AI / OpenRouter — Optional (AI features will be disabled without this)
# Sign up at https://openrouter.ai and generate an API key.
# If not set, users can still configure their own AI provider in Settings.
# Without this key AND no custom user config, AI card generation is unavailable.
# ------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
